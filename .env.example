# ==============================================================================
# Pre-Sales AI Command Center - Local Environment Configuration
# Copy this file to .env to customize settings.
# If APP_MASTER_KEY is omitted, the app will securely auto-generate and persist
# a local encryption key in ./data/.master.key (chmod 600).
# ==============================================================================

APP_HOST=127.0.0.1
APP_PORT=8080
APP_ENV=production
APP_MASTER_KEY=
SESSION_TTL_HOURS=12

# Optional: Default fallback API keys (can also be configured & encrypted via Web UI)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional: Google OAuth 2.0 PKCE Client ID for Direct Account Login
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional: WhatsApp Cloud API Integration
WHATSAPP_VERIFY_TOKEN=presales_ai_verify_token_change_me
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Optional: Postgres (e.g. Supabase) connection string. Empty = local SQLite in ./data.
# Supabase: Dashboard -> Connect -> Transaction pooler (port 6543).
DATABASE_URL=
